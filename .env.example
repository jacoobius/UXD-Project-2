# Set these in the hosting provider's Environment page (not in browser JavaScript).
# The app reads process environment variables; this example is documentation.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-service.onrender.com
DATABASE_PATH=/var/data/steadily.sqlite
TRUST_PROXY=1
STEADILY_AI_ENABLED=0
# Optional: after installing llama.cpp and the model on the app server:
# STEADILY_AI_ENABLED=1
# STEADILY_AI_MODEL=small
